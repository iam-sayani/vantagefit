{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "brand": {
      "coral": { "$type": "color", "$value": "#F15162" },
      "coralDeep": { "$type": "color", "$value": "#B8172A" },
      "teal": { "$type": "color", "$value": "#41D8B4" },
      "orange": { "$type": "color", "$value": "#FF9D57" },
      "slate": { "$type": "color", "$value": "#303740" }
    },
    "neutral": {
      "ink": { "$type": "color", "$value": "#29294C" },
      "text": { "$type": "color", "$value": "#50506D" },
      "canvas": { "$type": "color", "$value": "#F8F8F9" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surfaceSoft": { "$type": "color", "$value": "#F1F1F6" },
      "dark": { "$type": "color", "$value": "#1D2228" }
    },
    "semantic": {
      "action": { "$type": "color", "$value": "{color.brand.coralDeep}" },
      "positive": { "$type": "color", "$value": "#167F69" },
      "reward": { "$type": "color", "$value": "{color.brand.orange}" },
      "focus": { "$type": "color", "$value": "#146CBE" },
      "danger": { "$type": "color", "$value": "#A51225" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Noto Sans", "Arial", "sans-serif"] },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extraBold": { "$type": "fontWeight", "$value": 800 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "80px" },
    "10": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "8px" },
    "medium": { "$type": "dimension", "$value": "12px" },
    "large": { "$type": "dimension", "$value": "16px" },
    "extraLarge": { "$type": "dimension", "$value": "22px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "contentMax": { "$type": "dimension", "$value": "1180px" },
    "control": { "$type": "dimension", "$value": "48px" },
    "controlLarge": { "$type": "dimension", "$value": "56px" },
    "touchTargetMinimum": { "$type": "dimension", "$value": "44px" }
  }
}
